{
	"$schema": "https://biomejs.dev/schemas/latest/schema.json",
	"files": {
		"ignore": [
			"**/node_modules",
			"**/dist",
			"**/build",
			"**/.next",
			"**/coverage",
			"**/tsconfig*.json",
			"**/*.gen.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"semicolons": "asNeeded",
			"trailingCommas": "none",
			"arrowParentheses": "asNeeded",
			"quoteStyle": "double",
			"quoteProperties": "asNeeded",
			"jsxQuoteStyle": "single"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	}
}