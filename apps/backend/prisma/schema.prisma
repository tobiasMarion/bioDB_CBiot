generator client {
  provider     = "prisma-client"
  output       = "../src/common/prisma/generated/"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Example {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  name        String
  age         Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
